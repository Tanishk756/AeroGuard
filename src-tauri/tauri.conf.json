{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroGuard",
  "version": "0.1.0",
  "identifier": "com.aeroguard.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix apps/operator run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix apps/operator run build",
    "frontendDist": "../apps/operator/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AeroGuard — Counter-UAS Defensive Operations",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGFlcm9ndWFyZCBhdXRvLXVwZGF0ZXIgcHVibGljIGtleSBwbGFjZWhvbGRlcg==",
      "endpoints": [
        "https://releases.aeroguard.internal/update.json"
      ]
    }
  }
}
